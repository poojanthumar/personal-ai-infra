[Unit]
Description=personal-website-handler (www / wedding / admin)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/website-handler
EnvironmentFile=/opt/website-handler/.env
ExecStart=/usr/bin/java -jar /opt/website-handler/target/personal-website-handler-0.0.1-SNAPSHOT.jar
Restart=always
RestartSec=5
SuccessExitStatus=143

# Loopback is also set via SERVER_ADDRESS in .env
[Install]
WantedBy=multi-user.target
