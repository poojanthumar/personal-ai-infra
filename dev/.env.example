# Optional local overrides. Do not commit real secrets.
# Prefer Cloud Agent environment secrets for:
#   LITELLM_MASTER_KEY, WORKER_TOKEN, VM_DB_PASSWORD,
#   GEMINI_API_KEY, GITHUB_TOKEN, VM_PYTHON_TOKEN,
#   ORACLE_VM_SSH_PRIVATE_KEY (optional), TAILSCALE_AUTHKEY (required for VM access)
#
# TAILSCALE_AUTHKEY renewal: keys expire (~90 days). Before expiry, generate a
# new key at https://login.tailscale.com/admin/settings/keys and update the secret.

# LOCAL_DEV=1
# ORACLE_VM_TAILSCALE_IP=100.105.56.99
# HUB_URL=http://100.105.56.99:8000
# LITELLM_URL=http://100.105.56.99:4000/v1
