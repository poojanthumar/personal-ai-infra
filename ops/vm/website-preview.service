[Unit]
Description=personal-website-handler temporary branch preview
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/website-preview/current
EnvironmentFile=/home/ubuntu/website-preview/preview.env
ExecStart=/usr/bin/java -jar /home/ubuntu/website-preview/current/app.jar
Restart=on-failure
RestartSec=5
SuccessExitStatus=143

# The preview is deliberately started by deploy/preview-on-vm.sh and disabled at boot.
